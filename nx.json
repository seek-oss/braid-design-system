{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "useInferencePlugins": false,
  "affected": {
    "legacy": true
  },
  "targetDefaults": {
    "validate": {
      "dependsOn": ["validate:src", "validate:dist"],
      "executor": "nx:noop"
    },
    "build": {
      "cache": true
    },
    "build:playroom": {
      "cache": true
    },
    "build:site": {
      "cache": true
    },
    "generate": {
      "cache": true
    },
    "generate:component-docs": {
      "cache": true
    },
    "generate:icons": {
      "cache": true
    },
    "generate:snippets": {
      "cache": true
    }
  },
  "analytics": false
}
