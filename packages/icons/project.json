{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "icons",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "scripts": ["{projectRoot}/scripts/*"]
  },
  "targets": {
    "build": {
      "inputs": ["{projectRoot}/svg/*.svg", "scripts"],
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      }
    },
    "lint": {},
    "format": {}
  }
}
